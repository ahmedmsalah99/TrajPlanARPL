<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pad_motion_gazebo</name>
  <version>0.0.0</version>
  <description>gz-sim Model plugin that kinematically animates a perch pad's heave motion and publishes ground-truth px4_msgs/VehicleOdometry, for testing the SPA heave predictor (ros_traj_gen_utils) against a known signal.</description>

  <maintainer email="jeff@todo.todo">jeff</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <!-- gz-simN is version-dependent (Harmonic=8, Fortress=7) and resolved by
       CMakeLists.txt at configure time; not declared here as a single
       version-pinned key. Install ros-gz / gz-sim for your ROS distro per
       https://gazebosim.org/docs, e.g. `ros-jazzy-ros-gz` (Harmonic) or
       `ros-humble-ros-gz` (Fortress). -->
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
