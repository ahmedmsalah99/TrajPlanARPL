<?xml version="1.0"?>
<model>
  <name>wave_pad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>TrajPlanARPL</name>
  </author>
  <description>
    A perch pad that kinematically heaves via PadMotionPlugin and publishes
    ground-truth px4_msgs/VehicleOdometry (see PadMotionPlugin.cc) for
    testing ros_traj_gen_utils' SPA heave predictor against a known signal.
    Drop into an existing world via
      &lt;include&gt;&lt;uri&gt;model://wave_pad&lt;/uri&gt;&lt;pose&gt;...&lt;/pose&gt;&lt;/include&gt;
    (requires GZ_SIM_RESOURCE_PATH to include this package's models/
    directory -- see launch/pad_motion_sim.launch.py for how the standalone
    test world sets this up).
  </description>
</model>
